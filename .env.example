# JeevanRekha configuration (copy to .env and adjust; all optional locally).
# Every variable is read once at process start -- restart after editing.

# Runtime mode ----------------------------------------------------------------
# development (permissive, zero-config local simulator) | production
# (refuses to boot with the default SECRET_KEY or unauthenticated webhooks).
# JR_ENV=development

# Storage ------------------------------------------------------------------
# JR_DATABASE_URL=sqlite:///data/jeevanrekha.db
# JR_DATABASE_URL=postgresql+psycopg://jr:jr@localhost:5432/jeevanrekha
# JR_DATA_DIR=/var/lib/jeevanrekha
# Schema migrations: `alembic upgrade head` (the Docker entrypoint runs it
# automatically; set JR_SKIP_MIGRATIONS=1 on replica containers).

# Security -------------------------------------------------------------------
# JR_SECRET_KEY=generate-with: python -c "import secrets;print(secrets.token_hex(32))"
# Secure cookie flag (defaults to true when JR_ENV=production).
# JR_COOKIE_SECURE=true
# Double-submit CSRF protection for staff form POSTs (default true).
# JR_CSRF_ENABLED=true

# Telephony webhook authentication ---------------------------------------------
# A webhook is the only public door into the triage/dispatch machinery:
# without auth, anyone could POST /webhooks/responder-confirm and fake
# "ambulance confirmed" on a real emergency. Production refuses to boot with
# a real provider and neither of these set.
# Shared secret the provider must present (X-JR-Webhook-Secret header or
# ?token=... on the webhook URL -- Exotel dashboards can only set the URL).
# JR_WEBHOOK_SECRET=
# Comma-separated CIDR allowlist (Exotel's documented best practice is
# source-IP validation; run uvicorn with --proxy-headers behind your proxy).
# JR_WEBHOOK_CIDRS=
# Provider webhook replay window: identical (CallSid, digit) inside this many
# seconds is treated as a retry and not recorded twice.
# JR_WEBHOOK_DEDUP=8
# Twilio signature validation uses JR_TWILIO_TOKEN automatically.

# Public origin of this service (used to rebuild absolute webhook URLs for
# provider signature checks and, in Phase 2, ExoML endpoints).
# JR_PUBLIC_BASE_URL=https://api.jeevanrekha.example

# Rate limiting (per client IP, per worker process; the reverse proxy is the
# real edge defence). auth = POST /login, flow_start = POST /api/flow/start.
# JR_RATE_LIMIT_ENABLED=true
# JR_RATE_LIMIT_DEFAULT=240/minute
# JR_RATE_LIMIT_AUTH=20/minute
# JR_RATE_LIMIT_FLOW_START=30/minute

# Observability ----------------------------------------------------------------
# JR_SENTRY_DSN=
# JR_SENTRY_TRACES=0.1
# Scheduler heartbeat older than this = reported stale by /readyz.
# JR_HEARTBEAT_STALE=60
# Fail /readyz (503) on a stale heartbeat -- enable on the scheduler container.
# JR_READYZ_REQUIRE_SCHEDULER=false

# Dispatch / escalation --------------------------------------------------------
# Seconds a responder has to confirm before the attempt times out and the
# chain escalates. Keep well inside the 60-minute golden hour.
# JR_CONFIRM_WINDOW=480
# JR_MAX_ATTEMPTS=2
# JR_TICK=2.0
# Run the in-process escalation scheduler in THIS process. MUST be false on
# web workers when a dedicated `python -m app.services.scheduler_worker`
# process runs (docker-compose does this), or every worker escalates every
# timeout -- duplicate outbound calls on a real emergency.
# JR_RUN_SCHEDULER=true

# Telephony --------------------------------------------------------------------
# simulated (default) | exotel | twilio
# JR_TELEPHONY=simulated
# JR_EXOTEL_SID=
# JR_EXOTEL_TOKEN=
# JR_EXOTEL_SUBDOMAIN=api
# JR_EXOTEL_FROM=
# JR_TWILIO_SID=
# JR_TWILIO_TOKEN=
# JR_TWILIO_FROM=

# Display ----------------------------------------------------------------------
# JR_HELPLINE_DISPLAY=1800-XXX-XXXX

# docker-compose (Postgres) ------------------------------------------------------
# JR_PG_USER=jr
# JR_PG_PASSWORD=change-me
# JR_PG_DB=jeevanrekha
# JR_PORT=8300
